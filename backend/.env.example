# Application Configuration
PROJECT_NAME="CloudGuard API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (Defaults to local SQLite for instant setup; switch to PostgreSQL in staging/production)
# DATABASE_URL="postgresql+asyncpg://cloudguard:cloudguard_secret@localhost:5432/cloudguard_db"
DATABASE_URL="sqlite+aiosqlite:///./cloudguard.db"

# Security & Authentication
SECRET_KEY="supersecretjwtkey_replace_in_production_with_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Credentials / Profile (Optional: if not provided, boto3 looks for default IAM roles or ~/.aws/credentials)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
